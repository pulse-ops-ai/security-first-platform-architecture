# .gitignore
#
# Minimal baseline for the architecture repo. This is a docs/configs repo —
# the goal here is to prevent accidental commits of local dev artifacts,
# secrets, or live deployment state. Anything that should be SHARED
# (.pre-commit-config.yaml, .secrets.baseline, .gitleaks.toml) is NOT in
# this file.

# ----- OS -----
.DS_Store
Thumbs.db

# ----- Editors -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Python (pre-commit envs, scratch venvs) -----
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version

# ----- Node (templates/tooling may use it) -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Environment / secrets -----
# Never commit live env files. Real values live in a secret manager.
.env
.env.local
.env.*.local
*.env

# ----- Terraform local state and caches -----
# Real backends live in a solution-infra repo, not here.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Block real tfvars but keep the committed *.tfvars.example files.
*.tfvars
!*.tfvars.example

# ----- direnv -----
.envrc
.envrc.local

# ----- Pre-commit cache -----
.cache/
