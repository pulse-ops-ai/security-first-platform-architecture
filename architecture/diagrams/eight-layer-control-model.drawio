        <mxCell id="notes_title" value="Notes" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#222222;">
          <mxGeometry x="700" y="1190" width="640" height="22" as="geometry"/>
