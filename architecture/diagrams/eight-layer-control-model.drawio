          <mxGeometry x="320" y="110" width="280" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="l8_label" value="L8 — Semantic / agent reasoning" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#666666;whiteSpace=wrap;">
          <mxGeometry x="950" y="110" width="380" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="ext_client" value="External client&#10;(human user, browser, API caller)" vertex="1" parent="1" style="shape=umlActor;fillColor=#ffffff;strokeColor=#333333;fontSize=13;fontColor=#222222;verticalAlign=top;align=center;html=1;spacingTop=70;">
          <mxGeometry x="380" y="150" width="80" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ext_zone" value="(Z0 — untrusted internet)" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=2;">
          <mxGeometry x="480" y="180" width="200" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="l1" value="L1 — Network reachability&#10;&#10;Who can address the platform at all.&#10;Public DNS, edge firewall, allow-list, tunnels." vertex="1" parent="1" style="rounded=1;arcSize=8;fillColor=#fde2e2;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;whiteSpace=wrap;">
          <mxGeometry x="300" y="290" width="440" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="z_l1l2" value="Z0 — admission only, no zone change" vertex="1" parent="1" style="text;html=1;align=center;fontSize=12;fontColor=#b85450;fontStyle=2;">
          <mxGeometry x="300" y="385" width="440" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="l2" value="L2 — Edge gateway / routing&#10;&#10;TLS termination, request routing, WAF.&#10;The Z0 → Z1 trust crossing." vertex="1" parent="1" style="rounded=1;arcSize=8;fillColor=#fde2e2;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;whiteSpace=wrap;">
          <mxGeometry x="300" y="410" width="440" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="z_l2l3" value="→ Z1 (edge perimeter; TLS terminated)" vertex="1" parent="1" style="text;html=1;align=center;fontSize=12;fontColor=#d6b656;fontStyle=2;">
          <mxGeometry x="300" y="505" width="440" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="l3" value="L3 — Identity&#10;&#10;Verify who the caller is. Issue tokens.&#10;The Z1 → Z2 trust crossing." vertex="1" parent="1" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;whiteSpace=wrap;">
          <mxGeometry x="300" y="530" width="440" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="z_l3l4" value="→ Z2 (authenticated identity verified)" vertex="1" parent="1" style="text;html=1;align=center;fontSize=12;fontColor=#6c8ebf;fontStyle=2;">
          <mxGeometry x="300" y="625" width="440" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="l4" value="L4 — Authorization&#10;&#10;PDP decisions on (principal, action, resource).&#10;The Z2 → Z3 trust crossing." vertex="1" parent="1" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;whiteSpace=wrap;">
          <mxGeometry x="300" y="650" width="440" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="z_l4l5" value="→ Z3 (authorized to proceed)" vertex="1" parent="1" style="text;html=1;align=center;fontSize=12;fontColor=#82b366;fontStyle=2;">
          <mxGeometry x="300" y="745" width="440" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="l5" value="L5 — Operational guardrails&#10;&#10;Rate limits, quotas, kill switches, feature flags.&#10;Gating only — no zone crossing." vertex="1" parent="1" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#b46504;strokeWidth=2;fontSize=13;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;whiteSpace=wrap;">
          <mxGeometry x="300" y="770" width="440" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="z_l5l6" value="Z3 (stays within Z3; L5 gates, does not cross)" vertex="1" parent="1" style="text;html=1;align=center;fontSize=12;fontColor=#82b366;fontStyle=2;">
          <mxGeometry x="300" y="865" width="440" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="l6" value="L6 — Orchestrator / BFF&#10;&#10;Compose downstream services. Issue the internal&#10;identity envelope. The Z3 → Z4 trust crossing." vertex="1" parent="1" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#a45fae;strokeWidth=2;fontSize=13;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;whiteSpace=wrap;">
          <mxGeometry x="300" y="890" width="440" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="z_l6l7" value="→ Z4 (envelope issued, signed per ADR-0003)" vertex="1" parent="1" style="text;html=1;align=center;fontSize=12;fontColor=#9673a6;fontStyle=2;">
          <mxGeometry x="300" y="985" width="440" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="envelope_glyph" value="🔒" vertex="1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#9673a6;">
          <mxGeometry x="745" y="975" width="40" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="l7" value="L7 — Service enforcement&#10;&#10;Per-service authorization, tenant scope, audit.&#10;Verifies the envelope on every hop within Z4." vertex="1" parent="1" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;whiteSpace=wrap;">
          <mxGeometry x="300" y="1010" width="440" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="l8" value="L8 — Semantic / agent reasoning&#10;&#10;Whichever AI coding agent and automation runtimes&#10;the consuming team uses (Claude, Codex, in-house, …).&#10;&#10;Sits beside the stack. Re-enters the request path at&#10;L1/L2 as a client — never a back-channel into L7.&#10;Per ADR-0002, agents are clients." vertex="1" parent="1" style="rounded=1;arcSize=8;fillColor=#e8e8e8;strokeColor=#666666;strokeWidth=2;dashed=1;dashPattern=4 2;fontSize=13;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;whiteSpace=wrap;">
          <mxGeometry x="950" y="290" width="400" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="adr0002" value="ADR-0002 — agents are clients, not insiders" vertex="1" parent="1" style="text;html=1;align=center;fontSize=12;fontColor=#666666;fontStyle=2;">
          <mxGeometry x="950" y="505" width="400" height="18" as="geometry"/>
        </mxCell>

