        <mxCell id="intro" value="Copy any swatch on this page into your working diagram to inherit its style. Trust-zone colours and layer-ribbon strokes are workspace-wide vocabulary and are not negotiable per consumer. See standards/diagramming-conventions.md for the full vocabulary, drift mitigation rules, and anti-patterns." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;whiteSpace=wrap;">
          <mxGeometry x="40" y="80" width="1520" height="36" as="geometry"/>
        </mxCell>

