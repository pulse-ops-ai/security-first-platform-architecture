        <mxCell id="title" value="Workspace style library&#10;security-first platform architecture · v0.2.0-pre" vertex="1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;whiteSpace=wrap;">
